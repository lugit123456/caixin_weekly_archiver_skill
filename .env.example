# OpenAI-compatible LLM 服务
# 必填：用于生成中文总结和图片说明。只抓原文时可使用 --no-summary。
LLM_API_KEY=sk-REPLACE-ME
# 可选：兼容 OpenAI Chat Completions 的服务地址，留空时使用 OpenAI 默认地址。
LLM_BASE_URL=
# 正文总结模型。
LLM_MODEL=gpt-4o-mini
# 图片解析模型，留空时复用 LLM_MODEL。
OPENAI_VISION_MODEL=
# 单次生成的最大 token 数。
LLM_MAX_TOKENS=1800
# 生成温度；数值越低，输出越稳定。
LLM_TEMPERATURE=0.3
# 单次 LLM 请求超时时间（秒）。
LLM_TIMEOUT_S=60
# LLM 请求失败后的最大重试次数。
LLM_MAX_RETRIES=2

# 图片解析
# 是否为正文图片生成中文说明。
LLM_ANALYZE_ARTICLE_IMAGES=true
# 每篇文章最多解析的图片数量；图片本身仍会全部下载。
LLM_MAX_IMAGES_PER_ARTICLE=6

# 抓取节奏
# 两篇文章之间随机等待的最短和最长秒数。
CRAWL_DELAY_MIN_S=2
CRAWL_DELAY_MAX_S=4

# 财新自动登录。密码填写浏览器请求中解密前、只经过一次 URL 编码的加密字符串。
# 登录 Cookie 默认保存为项目内 .caixin-auth.json，并仅在登录态失效时重新登录。
CAIXIN_ACCOUNT=your-account@example.com
CAIXIN_PASSWORD=REPLACE_WITH_ONCE_PERCENT_ENCODED_ENCRYPTED_PASSWORD
CAIXIN_DEVICE_TYPE=5
CAIXIN_UNIT=1
CAIXIN_DEVICE=CaixinWebsite
# 留空时保存到项目内 .caixin-auth.json。
CAIXIN_COOKIE_PATH=

# 登录浏览器回退。自动登录 Cookie 会注入 Chromium；以下配置通常可以留空。
# 方式一：连接已用 --remote-debugging-port 启动且已登录财新的 Chromium。
BROWSER_ADDRESS=
# 方式二：使用独立的持久化浏览器 profile，首次运行 python sync_weekly.py --login 完成登录。
BROWSER_USER_DATA_PATH=
# 等待登录页面异步注入全文的最长时间（秒）。
BROWSER_CONTENT_WAIT_S=15

# 输出目录（可选）
# 留空时写入项目内的 output_results/。
OUTPUT_ROOT=
